# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Dynamic frameworks by default (11-05): React Native Firebase 27 resolves the Firebase Apple SDK
# through Swift Package Manager only, and requires `use_frameworks! :linkage => :dynamic`.
# USE_FRAMEWORKS still overrides it.
linkage = ENV['USE_FRAMEWORKS'] || 'dynamic'
Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
use_frameworks! :linkage => linkage.to_sym
# RNFB 27 pins Firebase Apple SDK 13.x, which needs Xcode 26.2 (Swift 6.2.3). This machine builds
# with Xcode 26.0.1, so stay on the last 12.x until Xcode is upgraded — then delete this line.
$FirebaseSDKVersion = '12.19.3'

# @azesmway/react-native-unity vendors UnityFramework from its own ios/ folder and
# relies on a podspec prepare_command to copy it there from unity/builds/ios.
# CocoaPods does not run prepare_command for local (:path) pods, and every
# `yarn install` wipes the copy anyway, so do the copy here on each pod install.
pre_install do |installer|
  unity_src = File.expand_path('../unity/builds/ios', __dir__)
  pod_ios = File.expand_path('../node_modules/@azesmway/react-native-unity/ios', __dir__)
  if Dir.exist?(unity_src) && Dir.exist?(pod_ios)
    Dir.glob(File.join(unity_src, 'UnityFramework.*')).each do |fw|
      dest = File.join(pod_ios, File.basename(fw))
      FileUtils.rm_rf(dest)
      FileUtils.cp_r(fw, dest)
      Pod::UI.puts "[unity] Copied #{File.basename(fw)} into react-native-unity pod".green
    end
  end
end

target 'prayers' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # GoogleSignIn (via @react-native-google-signin) pulls in AppCheckCore, a Swift pod whose two
  # ObjC dependencies ship no module maps — without these, `pod install` refuses to integrate it.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )
  end
end
