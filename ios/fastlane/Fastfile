default_platform(:ios)

# Same App Store Connect API key as saju_front (team LMV326UNSN). The .p8 stays outside the repo,
# in ~/.appstoreconnect/private_keys — altool and xcodebuild both look there.
ISSUER_ID = ENV.fetch("ASC_ISSUER_ID", "73f7fddb-24ba-40ef-9b65-55fbba016cfc")
KEY_ID    = ENV.fetch("ASC_KEY_ID", "L762GM985F")
KEY_PATH  = ENV.fetch("ASC_KEY_PATH", File.expand_path("~/.appstoreconnect/private_keys/AuthKey_#{KEY_ID}.p8"))

platform :ios do
  desc "Build and upload to TestFlight (build number = latest TestFlight build + 1)"
  lane :beta do
    api_key = app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH, duration: 1200)

    # ⚠️ UnityFramework must be the DEVICE export (iphoneos) — the simulator one fails at link time
    # with "building for 'iOS', but linking in dylib … built for 'iOS-simulator'".
    unity = File.expand_path("../../node_modules/@azesmway/react-native-unity/ios/UnityFramework.framework/UnityFramework", __dir__)
    UI.user_error!("UnityFramework is the simulator build — export Unity for device first") if sh("vtool -show-build #{unity.shellescape}", log: false).include?("IOSSIMULATOR")

    increment_build_number(
      xcodeproj: "prayers.xcodeproj",
      build_number: latest_testflight_build_number(api_key: api_key, initial_build_number: 0) + 1,
    )

    # The API key also signs: without these flags -allowProvisioningUpdates needs an Xcode Apple ID
    # session, which expires.
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{KEY_PATH.shellescape} " \
           "-authenticationKeyID #{KEY_ID} -authenticationKeyIssuerID #{ISSUER_ID}"
    build_app(
      workspace: "prayers.xcworkspace",
      scheme: "prayers",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "./build",
      output_name: "prayers.ipa",
      xcargs: auth,
      export_xcargs: "-allowProvisioningUpdates",
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end

platform :ios do
  desc "Recent builds and their processing state on App Store Connect"
  lane :builds do
    app_store_connect_api_key(key_id: KEY_ID, issuer_id: ISSUER_ID, key_filepath: KEY_PATH)
    app = Spaceship::ConnectAPI::App.find("com.fortunetorch.prayers")
    Spaceship::ConnectAPI::Build.all(app_id: app.id, sort: "-uploadedDate", limit: 5).each do |b|
      UI.message("#{b.app_version} (#{b.version})  #{b.processing_state}  uploaded #{b.uploaded_date}  expired=#{b.expired}")
    end
  end
end
