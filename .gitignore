# Unity-as-a-Library export artifacts (generated by saju_world_unity)
#
# BOTH directories are generated, and both are wiped and rewritten on every export:
# EmbeddedExportBuilder.Export does Directory.Delete(outDir, recursive) before it writes.
#   unity/xcode/   the exported Xcode PROJECT   (930 MB, 2372 files)
#   unity/builds/  the built UnityFramework.xcframework
# xcode/ was tracked while builds/ was ignored, so every export churned 2372 generated
# files through git for no reason — and a fresh clone got a stale project it would have
# to regenerate anyway.
unity/builds/
unity/xcode/
# Build logs from the export chain. They are what you read when a step fails
# silently — the Unity export swallows errors and only the log says why — so they
# are kept on disk and out of the repo. ~1.1 MB each.
unity/*.log

# Local server secret for dev builds (see devToken.example.ts). Never commit.
src/features/counseling/api/devToken.ts
