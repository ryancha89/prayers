{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    // `node` is here for the recorder test, which writes the Unity replay
    // fixture to disk — the only place this app touches fs.
    "types": ["jest", "node"],
    // The counselor roster ships as JSON generated by the Unity catalog builder — see
    // features/counselors/data/registry.ts. Importing it is how the two sides stop drifting.
    "resolveJsonModule": true
  },
  "include": ["**/*.ts", "**/*.tsx"],
  "exclude": ["**/node_modules", "**/Pods"]
}
